{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Rideppy Base",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true
  }
}
