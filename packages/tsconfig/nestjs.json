{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Rideppy NestJS API",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "isolatedModules": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  }
}
