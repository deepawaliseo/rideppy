# ============================================================================
# Rideppy API — environment template
# Copy to .env, then replace every CHANGE_ME placeholder with a strong LOCAL value.
# NEVER commit .env or real credentials.
# Local development boots with the defaults below; production startup FAILS
# unless JWT_SECRET and DATABASE_URL are set to strong, non-placeholder values.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3100

# --- Database: PostgreSQL 16 + PostGIS (WP-5) --------------------------------
# Copy this file to apps/api/.env (the API and the Prisma CLI both read it
# from there). See docs/DATABASE-SETUP.md for the full native Windows setup.
# Local default user/db = rideppy. Change the password from the placeholder!
DATABASE_URL=postgresql://rideppy:CHANGE_ME_TO_A_STRONG_LOCAL_PASSWORD@localhost:5432/rideppy
# Used only by optional docker compose (compose.yaml), same password as above:
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_LOCAL_PASSWORD

# --- Redis (jobs + realtime adapter, later phases) --------------------------
REDIS_URL=redis://localhost:6379

# --- Auth (WP-1: phone + OTP authentication) --------------------------------
# Must be >= 32 chars and non-placeholder in production (enforced at boot).
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_MIN_32_CHARACTERS
# ACCESS-token lifetime (short by design; refresh tokens carry the session).
JWT_EXPIRES_IN=15m
# Refresh-token session window in days (rotation lifetime, 1..365).
JWT_REFRESH_TTL_DAYS=30

# --- OTP delivery (WP-1) ------------------------------------------------------
# console = print OTP to the API log (development/test ONLY; production boot
#           FAILS with this provider). twilio/msg91 are declared but refuse
#           to boot until their OtpSender implementation + credentials exist.
OTP_PROVIDER=console
OTP_CODE_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_ACTIVE_PER_PHONE=3
OTP_HOURLY_REQUEST_LIMIT=10

# --- HTTP surface ------------------------------------------------------------
# '*' (any origin, dev only) or a comma-separated origin list,
# e.g. http://localhost:8081,https://admin.rideppy.example
# Production REFUSES to boot with '*' — always set explicit origins there.
CORS_ORIGIN=*

# --- Rate limiting ------------------------------------------------------------
# Global default (per IP):
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Stricter per-IP limits for the auth surface (WP-1, OTP abuse protection):
THROTTLE_OTP_REQUEST_LIMIT=5
THROTTLE_OTP_VERIFY_LIMIT=10
THROTTLE_REFRESH_LIMIT=20

# --- Swagger -------------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# --- MapLibre map provider (configurable licensed provider, decided later) -----
# One of: none | maptiler | mapmyindia | nextbillion | protomaps | custom
MAP_PROVIDER=none
MAP_STYLE_URL=
MAP_API_KEY=
